---ADC TOP---
`timescale 1ns / 1ps

module timer_adc8_top (
    input  wire       clk,
    input  wire       rst_n,
    // 8-bit APB slave interface
    input  wire       psel,
    input  wire       penable,
    input  wire       pwrite,
    input  wire [3:0] paddr,
    input  wire [7:0] pwdata,
    output wire [7:0] prdata,
    output wire       pready,
    output wire       pslverr,
    // Interrupt and PWM outputs
    output wire       irq,
    output wire       pwm_out,
    // Analog Front-End (AFE) interface
    output wire       adc_sample,
    output wire [1:0] adc_ch,
    output wire [7:0] adc_dac,
    input  wire       adc_cmp
);

    // Timer signals
    wire       tmr_en;
    wire       tmr_oneshot;
    wire [7:0] tmr_presc;
    wire [7:0] tmr_load;
    wire [7:0] tmr_cmp;
    wire [7:0] tmr_cnt;
    wire       tmr_ovf;
    wire       tmr_cmp_evt;

    // ADC signals
    wire       adc_en;
    wire       adc_sw_start;
    wire [1:0] adc_trig_sel;
    wire [1:0] cfg_adc_ch;
    wire [7:0] adc_smp;
    wire [7:0] adc_div;
    wire       adc_busy;
    wire       adc_eoc;
    wire [7:0] adc_result;
    wire [1:0] adc_result_ch;

    // Trigger routing mux
    wire adc_start_trig = (adc_trig_sel == 2'd0) ? adc_sw_start :
                          (adc_trig_sel == 2'd1) ? tmr_ovf      :
                          (adc_trig_sel == 2'd2) ? tmr_cmp_evt  : 1'b0;
    wire adc_cont_mode  = (adc_trig_sel == 2'd3);

    // FIFO signals
    wire [9:0] fifo_dout;
    wire       fifo_full;
    wire       fifo_empty;
    wire [3:0] fifo_level;
    wire       fifo_pop;

    apb_regs8 u_regs (
        .clk          (clk),
        .rst_n        (rst_n),
        .psel         (psel),
        .penable      (penable),
        .pwrite       (pwrite),
        .paddr        (paddr),
        .pwdata       (pwdata),
        .prdata       (prdata),
        .pready       (pready),
        .pslverr      (pslverr),
        .tmr_en       (tmr_en),
        .tmr_oneshot  (tmr_oneshot),
        .tmr_presc    (tmr_presc),
        .tmr_load     (tmr_load),
        .tmr_cmp      (tmr_cmp),
        .tmr_cnt      (tmr_cnt),
        .tmr_ovf      (tmr_ovf),
        .tmr_cmp_evt  (tmr_cmp_evt),
        .adc_en       (adc_en),
        .adc_sw_start (adc_sw_start),
        .adc_trig_sel (adc_trig_sel),
        .adc_ch       (cfg_adc_ch),
        .adc_smp      (adc_smp),
        .adc_div      (adc_div),
        .adc_busy     (adc_busy),
        .adc_eoc      (adc_eoc),
        .adc_result   (adc_result),
        .fifo_data    (fifo_dout[7:0]),
        .fifo_ch      (fifo_dout[9:8]),
        .fifo_full    (fifo_full),
        .fifo_empty   (fifo_empty),
        .fifo_level   (fifo_level),
        .fifo_pop     (fifo_pop),
        .irq          (irq)
    );

    timer8 u_timer (
        .clk          (clk),
        .rst_n        (rst_n),
        .en           (tmr_en),
        .oneshot      (tmr_oneshot),
        .presc        (tmr_presc),
        .load         (tmr_load),
        .cmp          (tmr_cmp),
        .cnt          (tmr_cnt),
        .ovf_pulse    (tmr_ovf),
        .cmp_pulse    (tmr_cmp_evt),
        .pwm_out      (pwm_out)
    );

    sar_adc_ctrl #(
        .N            (8)
    ) u_adc (
        .clk          (clk),
        .rst_n        (rst_n),
        .en           (adc_en),
        .start_trig   (adc_start_trig),
        .cont_mode    (adc_cont_mode),
        .ch_sel       (cfg_adc_ch),
        .smp          (adc_smp),
        .div          (adc_div),
        .busy         (adc_busy),
        .eoc          (adc_eoc),
        .result       (adc_result),
        .result_ch    (adc_result_ch),
        .adc_sample   (adc_sample),
        .adc_ch       (adc_ch),
        .adc_dac      (adc_dac),
        .adc_cmp      (adc_cmp)
    );

    sync_fifo #(
        .WIDTH        (10),
        .DEPTH        (8),
        .ADDR_W       (3)
    ) u_fifo (
        .clk          (clk),
        .rst_n        (rst_n),
        .push         (adc_eoc),
        .din          ({adc_result_ch, adc_result}),
        .pop          (fifo_pop),
        .dout         (fifo_dout),
        .full         (fifo_full),
        .empty        (fifo_empty),
        .level        (fifo_level)
    );

endmodule

---APB REGISTERS---
`timescale 1ns / 1ps

module apb_regs8 (
    input  wire       clk,
    input  wire       rst_n,
    // APB slave interface
    input  wire       psel,
    input  wire       penable,
    input  wire       pwrite,
    input  wire [3:0] paddr,
    input  wire [7:0] pwdata,
    output reg  [7:0] prdata,
    output wire       pready,
    output wire       pslverr,
    // Timer interface
    output reg        tmr_en,
    output reg        tmr_oneshot,
    output reg  [7:0] tmr_presc,
    output reg  [7:0] tmr_load,
    output reg  [7:0] tmr_cmp,
    input  wire [7:0] tmr_cnt,
    input  wire       tmr_ovf,
    input  wire       tmr_cmp_evt,
    // ADC interface
    output reg        adc_en,
    output reg        adc_sw_start,
    output reg  [1:0] adc_trig_sel,
    output reg  [1:0] adc_ch,
    output reg  [7:0] adc_smp,
    output reg  [7:0] adc_div,
    input  wire       adc_busy,
    input  wire       adc_eoc,
    input  wire [7:0] adc_result,
    // FIFO interface
    input  wire [7:0] fifo_data,
    input  wire [1:0] fifo_ch,
    input  wire       fifo_full,
    input  wire       fifo_empty,
    input  wire [3:0] fifo_level,
    output wire       fifo_pop,
    // Interrupt output
    output wire       irq
);

    // Register address map
    localparam [3:0] ADDR_TMR_CTRL   = 4'h0,
                     ADDR_TMR_PRESC  = 4'h1,
                     ADDR_TMR_LOAD   = 4'h2,
                     ADDR_TMR_CMP    = 4'h3,
                     ADDR_TMR_CNT    = 4'h4,
                     ADDR_ADC_CTRL   = 4'h5,
                     ADDR_ADC_SMP    = 4'h6,
                     ADDR_ADC_DIV    = 4'h7,
                     ADDR_ADC_THR_LO = 4'h8,
                     ADDR_ADC_THR_HI = 4'h9,
                     ADDR_ADC_DATA   = 4'hA,
                     ADDR_ADC_RCH    = 4'hB,
                     ADDR_ADC_STAT   = 4'hC,
                     ADDR_IRQ_EN     = 4'hD,
                     ADDR_IRQ_STAT   = 4'hE,
                     ADDR_ID         = 4'hF;

    reg [7:0] adc_thr_lo;
    reg [7:0] adc_thr_hi;
    reg [5:0] irq_en;
    reg [5:0] irq_stat;

    assign pready  = 1'b1;
    assign pslverr = 1'b0;

    wire bus_wr = psel && penable &&  pwrite;
    wire bus_rd = psel && penable && !pwrite;

    // Pop FIFO on read access to ADC_DATA (0xA)
    assign fifo_pop = bus_rd && (paddr == ADDR_ADC_DATA);

    // Hardware event sources for IRQ_STAT
    // NGUYEN VIET ANH - SE204450
    wire sel_trig_pulse = (adc_trig_sel == 2'd0) ? adc_sw_start :
                          (adc_trig_sel == 2'd1) ? tmr_ovf      :
                          (adc_trig_sel == 2'd2) ? tmr_cmp_evt  : 1'b0;

    wire evt_tmr_ovf   = tmr_ovf;
    wire evt_tmr_cmp   = tmr_cmp_evt;
    wire evt_adc_eoc   = adc_eoc;
    wire evt_adc_wd    = adc_eoc && ((adc_result < adc_thr_lo) || (adc_result > adc_thr_hi));
    wire evt_fifo_ovr  = adc_eoc && fifo_full;
    wire evt_trig_miss = adc_en && adc_busy && sel_trig_pulse;

    wire [5:0] hw_events = {
        evt_trig_miss, // [5] TRIG_MISS
        evt_fifo_ovr,  // [4] FIFO_OVR
        evt_adc_wd,    // [3] ADC_WD
        evt_adc_eoc,   // [2] ADC_EOC
        evt_tmr_cmp,   // [1] TMR_CMP
        evt_tmr_ovf    // [0] TMR_OVF
    };

    wire [5:0] w1c_mask = (bus_wr && (paddr == ADDR_IRQ_STAT)) ? pwdata[5:0] : 6'd0;

    // Synchronous register writes and hardware flag updates
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            tmr_en       <= 1'b0;
            tmr_oneshot  <= 1'b0;
            tmr_presc    <= 8'h00;
            tmr_load     <= 8'hFF;
            tmr_cmp      <= 8'h80;
            adc_en       <= 1'b0;
            adc_sw_start <= 1'b0;
            adc_trig_sel <= 2'd0;
            adc_ch       <= 2'd0;
            adc_smp      <= 8'h04;
            adc_div      <= 8'h00;
            adc_thr_lo   <= 8'h00;
            adc_thr_hi   <= 8'hFF;
            irq_en       <= 6'h00;
            irq_stat     <= 6'h00;
        end else begin
            // START is a self-clearing 1-clock pulse
            adc_sw_start <= 1'b0;

            // One-shot mode hardware auto-clear of TMR_CTRL.EN on overflow
            if (tmr_ovf && tmr_oneshot) begin
                tmr_en <= 1'b0;
            end

            if (bus_wr) begin
                case (paddr)
                    ADDR_TMR_CTRL: begin
                        tmr_en      <= pwdata[0];
                        tmr_oneshot <= pwdata[1];
                    end
                    ADDR_TMR_PRESC:  tmr_presc  <= pwdata;
                    ADDR_TMR_LOAD:   tmr_load   <= pwdata;
                    ADDR_TMR_CMP:    tmr_cmp    <= pwdata;
                    ADDR_ADC_CTRL: begin
                        adc_en       <= pwdata[0];
                        adc_sw_start <= pwdata[1] && pwdata[0];
                        adc_trig_sel <= pwdata[3:2];
                        adc_ch       <= pwdata[5:4];
                    end
                    ADDR_ADC_SMP:    adc_smp    <= pwdata;
                    ADDR_ADC_DIV:    adc_div    <= pwdata;
                    ADDR_ADC_THR_LO: adc_thr_lo <= pwdata;
                    ADDR_ADC_THR_HI: adc_thr_hi <= pwdata;
                    ADDR_IRQ_EN:     irq_en     <= pwdata[5:0];
                    default: ;
                endcase
            end

            // Hardware set wins over a same-cycle CPU W1C clear
            irq_stat <= (irq_stat & ~w1c_mask) | hw_events;
        end
    end

    // Combinational read mux (0 when not selected)
    always @(*) begin
        if (psel && !pwrite) begin
            case (paddr)
                ADDR_TMR_CTRL:   prdata = {6'd0, tmr_oneshot, tmr_en};
                ADDR_TMR_PRESC:  prdata = tmr_presc;
                ADDR_TMR_LOAD:   prdata = tmr_load;
                ADDR_TMR_CMP:    prdata = tmr_cmp;
                ADDR_TMR_CNT:    prdata = tmr_cnt;
                ADDR_ADC_CTRL:   prdata = {2'd0, adc_ch, adc_trig_sel, 1'b0, adc_en};
                ADDR_ADC_SMP:    prdata = adc_smp;
                ADDR_ADC_DIV:    prdata = adc_div;
                ADDR_ADC_THR_LO: prdata = adc_thr_lo;
                ADDR_ADC_THR_HI: prdata = adc_thr_hi;
                ADDR_ADC_DATA:   prdata = fifo_empty ? 8'h00 : fifo_data;
                ADDR_ADC_RCH:    prdata = fifo_empty ? 8'h00 : {1'b1, 5'd0, fifo_ch};
                ADDR_ADC_STAT:   prdata = {1'b0, adc_busy, fifo_full, fifo_empty, fifo_level};
                ADDR_IRQ_EN:     prdata = {2'd0, irq_en};
                ADDR_IRQ_STAT:   prdata = {2'd0, irq_stat};
                ADDR_ID:         prdata = 8'hA8;
                default:         prdata = 8'h00;
            endcase
        end else begin
            prdata = 8'h00;
        end
    end

    assign irq = |(irq_stat & irq_en);

endmodule

---TIMER---
`timescale 1ns / 1ps

module timer8 (
    input  wire       clk,
    input  wire       rst_n,
    input  wire       en,
    input  wire       oneshot,
    input  wire [7:0] presc,
    input  wire [7:0] load,
    input  wire [7:0] cmp,
    output reg  [7:0] cnt,
    output reg        ovf_pulse,
    output reg        cmp_pulse,
    output wire       pwm_out
);

    reg [7:0] presc_cnt;

    // Prescaler tick: fires every (presc + 1) clocks while enabled.
    // In one-shot mode, suppress ticking on the cycle ovf_pulse is high
    // while the register block clears EN.
    wire active = en && !(oneshot && ovf_pulse);
    wire tick   = active && (presc_cnt >= presc);

    assign pwm_out = active ? (cnt < cmp) : 1'b0;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            presc_cnt <= 8'd0;
            cnt       <= 8'd0;
            ovf_pulse <= 1'b0;
            cmp_pulse <= 1'b0;
        end else begin
            ovf_pulse <= 1'b0;
            cmp_pulse <= 1'b0;

            if (!active) begin
                presc_cnt <= 8'd0;
                cnt       <= 8'd0;
            end else begin
                if (tick) begin
                    presc_cnt <= 8'd0;

                    if (cnt == cmp) begin
                        cmp_pulse <= 1'b1;
                    end

                    if (cnt >= load) begin
                        cnt       <= 8'd0;
                        ovf_pulse <= 1'b1;
                    end else begin
                        cnt       <= cnt + 8'd1;
                    end
                end else begin
                    presc_cnt <= presc_cnt + 8'd1;
                end
            end
        end
    end

endmodule

---SAR CONTROLLER---
`timescale 1ns / 1ps

module sar_adc_ctrl #(
    parameter integer N = 8
)(
    input  wire           clk,
    input  wire           rst_n,
    input  wire           en,
    input  wire           start_trig,
    input  wire           cont_mode,
    input  wire [1:0]     ch_sel,
    input  wire [7:0]     smp,
    input  wire [7:0]     div,
    output reg            busy,
    output reg            eoc,
    output reg  [N-1:0]   result,
    output reg  [1:0]     result_ch,
    // Analog Front-End (AFE) interface
    output reg            adc_sample,
    output reg  [1:0]     adc_ch,
    output reg  [N-1:0]   adc_dac,
    input  wire           adc_cmp
);

    localparam [1:0] S_IDLE    = 2'd0,
                     S_SAMPLE  = 2'd1,
                     S_CONVERT = 2'd2,
                     S_DONE    = 2'd3;

    reg [1:0] state;
    reg [7:0] div_cnt;
    reg [7:0] smp_cnt;
    reg [2:0] bit_idx;

    wire adc_tick = (div_cnt >= div);

    // Next DAC value resolved during CONVERT
    reg [N-1:0] next_dac;
    always @(*) begin
        next_dac          = adc_dac;
        next_dac[bit_idx] = adc_cmp;
    end

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state      <= S_IDLE;
            div_cnt    <= 8'd0;
            smp_cnt    <= 8'd0;
            bit_idx    <= 3'd0;
            busy       <= 1'b0;
            eoc        <= 1'b0;
            result     <= {N{1'b0}};
            result_ch  <= 2'd0;
            adc_sample <= 1'b0;
            adc_ch     <= 2'd0;
            adc_dac    <= {N{1'b0}};
        end else if (!en) begin
            // Clearing ADC_CTRL.EN aborts conversion immediately
            state      <= S_IDLE;
            div_cnt    <= 8'd0;
            smp_cnt    <= 8'd0;
            bit_idx    <= 3'd0;
            busy       <= 1'b0;
            eoc        <= 1'b0;
            adc_sample <= 1'b0;
            adc_dac    <= {N{1'b0}};
        end else begin
            eoc <= 1'b0;

            case (state)
                S_IDLE: begin
                    busy       <= 1'b0;
                    adc_sample <= 1'b0;
                    adc_dac    <= {N{1'b0}};
                    if (start_trig || cont_mode) begin
                        state      <= S_SAMPLE;
                        busy       <= 1'b1;
                        adc_sample <= 1'b1;
                        adc_ch     <= ch_sel;
                        div_cnt    <= 8'd0;
                        smp_cnt    <= 8'd0;
                    end
                end

                S_SAMPLE: begin
                    busy       <= 1'b1;
                    adc_sample <= 1'b1;
                    if (adc_tick) begin
                        div_cnt <= 8'd0;
                        if (smp_cnt >= smp) begin
                            state      <= S_CONVERT;
                            adc_sample <= 1'b0;
                            bit_idx    <= N[2:0] - 3'd1;
                            adc_dac    <= (1'b1 << (N - 1));
                        end else begin
                            smp_cnt <= smp_cnt + 8'd1;
                        end
                    end else begin
                        div_cnt <= div_cnt + 8'd1;
                    end
                end

                S_CONVERT: begin
                    busy       <= 1'b1;
                    adc_sample <= 1'b0;
                    if (adc_tick) begin
                        div_cnt <= 8'd0;
                        if (bit_idx == 3'd0) begin
                            state     <= S_DONE;
                            busy      <= 1'b0;
                            eoc       <= 1'b1;
                            result    <= next_dac;
                            result_ch <= adc_ch;
                            adc_dac   <= {N{1'b0}};
                        end else begin
                            adc_dac <= next_dac | (1'b1 << (bit_idx - 3'd1));
                            bit_idx <= bit_idx - 3'd1;
                        end
                    end else begin
                        div_cnt <= div_cnt + 8'd1;
                    end
                end

                S_DONE: begin
                    if (cont_mode || start_trig) begin
                        state      <= S_SAMPLE;
                        busy       <= 1'b1;
                        adc_sample <= 1'b1;
                        adc_ch     <= ch_sel;
                        div_cnt    <= 8'd0;
                        smp_cnt    <= 8'd0;
                    end else begin
                        state      <= S_IDLE;
                        busy       <= 1'b0;
                        adc_sample <= 1'b0;
                    end
                end

                default: state <= S_IDLE;
            endcase
        end
    end

endmodule

---FIFO SYNC---
`timescale 1ns / 1ps

module sync_fifo #(
    parameter integer WIDTH  = 10,
    parameter integer DEPTH  = 8,
    parameter integer ADDR_W = 3
)(
    input  wire              clk,
    input  wire              rst_n,
    input  wire              push,
    input  wire [WIDTH-1:0]  din,
    input  wire              pop,
    output wire [WIDTH-1:0]  dout,
    output wire              full,
    output wire              empty,
    output reg  [ADDR_W:0]   level
);

    reg [WIDTH-1:0]  mem [0:DEPTH-1];
    reg [ADDR_W-1:0] wr_ptr;
    reg [ADDR_W-1:0] rd_ptr;

    assign full  = (level == DEPTH[ADDR_W:0]);
    assign empty = (level == {(ADDR_W+1){1'b0}});

    // Drop new results if FIFO is already full
    wire do_push = push && !full;
    wire do_pop  = pop  && !empty;

    // Show-ahead read so ADC_RCH and ADC_DATA are valid combinationally
    assign dout  = empty ? {WIDTH{1'b0}} : mem[rd_ptr];

    integer i;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            wr_ptr <= {ADDR_W{1'b0}};
            rd_ptr <= {ADDR_W{1'b0}};
            level  <= {(ADDR_W+1){1'b0}};
            for (i = 0; i < DEPTH; i = i + 1) begin
                mem[i] <= {WIDTH{1'b0}};
            end
        end else begin
            if (do_push) begin
                mem[wr_ptr] <= din;
                wr_ptr      <= wr_ptr + 1'b1;
            end

            if (do_pop) begin
                rd_ptr <= rd_ptr + 1'b1;
            end

            case ({do_push, do_pop})
                2'b10:   level <= level + 1'b1;
                2'b01:   level <= level - 1'b1;
                default: level <= level;
            endcase
        end
    end

endmodule
